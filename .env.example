# Telegram Bot Configuration
# Obtained from @BotFather on Telegram (e.g. 7123456789:AAFlmNpQrStUvWxYz123456789abcdefghi)
TELEGRAM_BOT_TOKEN=""

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
MONGODB_URI="mongodb://localhost:27017/telegram_matchmaking"

# Admin Telegram User IDs (Comma-separated numeric Telegram IDs of authorized administrators)
ADMIN_TELEGRAM_IDS=""

# Optional: Image URL used when dispatching a rich media broadcast via /admin
BROADCAST_BANNER_URL=""

# Web Server Port (Defaults to 3000)
PORT=3000

# Environment Mode
NODE_ENV="production"
